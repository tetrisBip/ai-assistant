# === Telegram ===
TELEGRAM_TOKEN=
OWNER_ID=123456789

# === LLM: Groq (основной) ===
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === LLM: резервы ===
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# === Время и напоминания ===
TZ=Europe/Moscow
PILLS_MORNING=12:10
PILLS_EVENING=22:20
CHECKIN_TIME=22:00

# === Поиск ===
# duckduckgo (по умолчанию) или tavily
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# === Прочее ===
LOG_LEVEL=INFO
DB_PATH=data/assistant.db

TELEGRAM_PROXY=
DRY_RUN=false


